{
	"name": "dotpi-personal-config",
	"version": "0.1.0",
	"description": "Personal Pi configuration as an installable Pi package: extensions, skills, prompts, themes, and subagent definitions.",
	"type": "module",
	"scripts": {
		"build:prompts": "node prompt-catalog/build.mjs",
		"check:prompts": "node prompt-catalog/build.mjs --check",
		"test:prompts": "node --test prompt-catalog/catalog.test.mjs"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"prompt-snippets",
		"subagents"
	],
	"pi": {
		"extensions": [
			"extensions/*/index.ts",
			"!extensions/kinetograph/index.ts"
		],
		"skills": ["skills"]
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	}
}
